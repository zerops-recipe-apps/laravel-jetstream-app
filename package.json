{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "laravel-jetstream-app",
    "version": "1.0.0",
    "description": "Laravel 13 + Jetstream 5 (Inertia/Vue SSR) recipe on Zerops with PostgreSQL, Redis, S3, and Mailpit.",
    "author": "Zerops",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/zerops-recipe-apps/laravel-jetstream-app.git"
    },
    "homepage": "https://github.com/zerops-recipe-apps/laravel-jetstream-app",
    "bugs": {
        "url": "https://github.com/zerops-recipe-apps/laravel-jetstream-app/issues"
    },
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build && vite build --ssr"
    },
    "devDependencies": {
        "@inertiajs/vue3": "2.3.15",
        "@tailwindcss/forms": "0.5.11",
        "@tailwindcss/typography": "0.5.19",
        "@vitejs/plugin-vue": "6.0.5",
        "@vue/server-renderer": "3.5.29",
        "autoprefixer": "10.4.27",
        "axios": "1.19.0",
        "laravel-vite-plugin": "3.0.1",
        "postcss": "8.5.8",
        "tailwindcss": "3.4.19",
        "vite": "8.2.1",
        "vue": "3.5.29"
    },
    "keywords": [
        "laravel",
        "jetstream",
        "inertia",
        "vue",
        "zerops"
    ],
    "overrides": {
        "shell-quote": "1.10.0"
    }
}
